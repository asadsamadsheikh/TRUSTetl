# Copy this file to backend/.env and fill in your own values.
# backend/.env is git-ignored. Never commit real credentials.

# PostgreSQL connection (SQLAlchemy 2.x + psycopg 3).
# URL-encode special characters in the password (e.g. @ -> %40).
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/trustetl_database

# Comma-separated list of browser origins allowed to call the API cross-origin.
# Not needed when the pages are served by this app (http://localhost:8000).
# Example for VS Code Live Server: http://127.0.0.1:5500,http://localhost:5500
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
